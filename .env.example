# Copy to .env. This is a LOCAL development database, not a cloud connection.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Demo mode seeds the two public assessment accounts. Disable for a private deployment.
DEMO_MODE=true
# Force Secure cookies on an HTTPS-only deployment, including non-browser clients.
# Keep unset for local HTTP development; verified HTTPS browser Origins are detected.
# SESSION_COOKIE_SECURE=true
NEXT_TELEMETRY_DISABLED=1
# Optional: API test target. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000
